# Copy to .env and fill in.

# Where listings come from: demo | serpapi | facebook
SOURCE=demo

# SOURCE=serpapi: your key from serpapi.com
SERPAPI_KEY=

# SOURCE=facebook: path to the saved login session (see README, "Facebook cookies")
# FB_STORAGE_STATE=/data/fb_state.json

# Daily scan time
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=17
SCHEDULE_TZ=America/Chicago

# Upper bound on Marketplace requests per scan (searches x pickup areas). Extra ones roll to the next day.
MAX_REQUESTS_PER_RUN=150

# Also search the buyer's own area (default: only other people's areas)
INCLUDE_OWN_AREA=false

# First invite code (admins can rotate it in the app). Leave empty to generate one.
INVITE_CODE=

# Set to true once you serve the app over HTTPS
SECURE_COOKIES=false

# Optional. Defaults: a random key kept in DATA_DIR, and SQLite at DATA_DIR/app.db
# SECRET_KEY=
# DATABASE_URL=sqlite:////data/app.db
